BOBERDETECTIVE_ENV=development
BOBERDETECTIVE_DATA_ROOT=/home/bober/boberdetective-data
BOBERDETECTIVE_API_PREFIX=/api/v1
BOBERDETECTIVE_DATABASE_URL=postgresql+psycopg://boberdetective:boberdetective_dev_password@127.0.0.1:5432/boberdetective
POSTGRES_DB=boberdetective
POSTGRES_USER=boberdetective
POSTGRES_PASSWORD=boberdetective_dev_password
POSTGRES_PORT=5432
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6333
BOBERDETECTIVE_LLM_PROVIDER=lm_studio
BOBERDETECTIVE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Required only when LM Studio API authentication is enabled.
BOBERDETECTIVE_LLM_API_KEY=lm-studio
# Active workstation profile. For the quality profile use qwen/qwen3.6-35b-a3b with eval batch size 512.
BOBERDETECTIVE_LLM_CHAT_MODEL=qwen/qwen3.5-9b
BOBERDETECTIVE_LLM_EMBEDDING_MODEL=text-embedding-bge-m3
BOBERDETECTIVE_LLM_TIMEOUT_SECONDS=120
BOBERDETECTIVE_LLM_CHAT_CONTEXT_LENGTH=61440
BOBERDETECTIVE_LLM_EMBEDDING_CONTEXT_LENGTH=4096
BOBERDETECTIVE_LLM_EVAL_BATCH_SIZE=4096
BOBERDETECTIVE_LLM_FLASH_ATTENTION=true
BOBERDETECTIVE_LLM_OFFLOAD_KV_CACHE_TO_GPU=true
BOBERDETECTIVE_LLM_AUTO_LOAD_CHAT_MODEL=true
BOBERDETECTIVE_LLM_AUTO_LOAD_EMBEDDING_MODEL=true
BOBERDETECTIVE_EMBEDDING_BATCH_SIZE=8
BOBERDETECTIVE_PDF_PARSER=docling_then_pypdf
BOBERDETECTIVE_TESSERACT_CMD=tesseract
BOBERDETECTIVE_TESSERACT_LANGUAGES=hun+eng
BOBERDETECTIVE_MAX_UPLOAD_BYTES=52428800
